* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f2f2f2;
  color: #222;
}

/* CABEÇALHO */

header {
  background: #222;
  color: white;
  padding: 20px 50px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

header h1 {
  font-size: 30px;
}

nav a {
  color: white;
  text-decoration: none;
  font-size: 18px;
}

nav a:hover {
  color: #4caf50;
}


/* CONTEÚDO */

main {
  min-height: 80vh;
  padding: 50px 20px;
}

main h2 {
  text-align: center;
  margin-bottom: 40px;
  font-size: 28px;
}


/* ÁREA DOS CARTÕES */

.cartoes {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30px;
  flex-wrap: wrap;
}


/* CARTÃO */

.cartao {
  width: 280px;
  height: 380px;

  perspective: 1000px;

  cursor: pointer;
}


/* PARTE INTERNA */

.cartao-interno {
  width: 100%;
  height: 100%;

  position: relative;

  transition: transform 0.8s;

  transform-style: preserve-3d;
}


/* GIRO */

.cartao:hover .cartao-interno {
  transform: rotateY(180deg);
}


/* FRENTE E VERSO */

.cartao-frente,
.cartao-verso {
  position: absolute;

  width: 100%;
  height: 100%;

  border-radius: 20px;

  overflow: hidden;

  backface-visibility: hidden;

  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
}


/* FRENTE */

.cartao-frente {
  background: white;

  text-align: center;
}

.cartao-frente img {
  width: 100%;
  height: 280px;

  object-fit: cover;
}

.cartao-frente h3 {
  padding: 20px;

  font-size: 20px;
}


/* VERSO */

.cartao-verso {
  background: #4caf50;

  color: white;

  padding: 30px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  text-align: center;

  transform: rotateY(180deg);
}

.cartao-verso h3 {
  font-size: 28px;

  margin-bottom: 20px;
}

.cartao-verso p {
  font-size: 18px;

  line-height: 1.5;
}


/* RODAPÉ */

footer {
  background: #222;

  color: white;

  text-align: center;

  padding: 20px;
}


/* CELULAR */

@media (max-width: 700px) {

  header {
    padding: 20px;
  }

  main {
    padding: 30px 15px;
  }

  main h2 {
    font-size: 22px;
  }

  .cartao {
    width: 280px;
    height: 380px;
  }

}