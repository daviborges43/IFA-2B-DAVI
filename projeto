/* ========================= */
/* CONFIGURAÇÃO GERAL */
/* ========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;

  background: linear-gradient(
    135deg,
    #e8f5e9,
    #ffffff
  );

  color: #222;

  min-height: 100vh;
}


/* ========================= */
/* CABEÇALHO */
/* ========================= */

header {
  background: #1b5e20;

  color: white;

  padding: 20px 50px;

  display: flex;

  justify-content: space-between;

  align-items: center;
}

header h1 {
  font-size: 32px;
}

nav a {
  color: white;

  text-decoration: none;

  font-size: 18px;

  transition: 0.3s;
}

nav a:hover {
  color: #a5d6a7;
}


/* ========================= */
/* CONTEÚDO */
/* ========================= */

main {
  min-height: 85vh;

  padding: 50px 30px;
}

main h2 {
  text-align: center;

  font-size: 30px;

  color: #1b5e20;

  margin-bottom: 45px;
}


/* ========================= */
/* ÁREA DOS CARTÕES */
/* ========================= */

.cartoes {
  display: flex;

  justify-content: center;

  align-items: center;

  gap: 35px;

  flex-wrap: wrap;
}


/* ========================= */
/* CARTÃO */
/* ========================= */

.cartao {
  width: 280px;

  height: 400px;

  perspective: 1000px;

  cursor: pointer;
}


/* ========================= */
/* PARTE INTERNA */
/* ========================= */

.cartao-interno {
  position: relative;

  width: 100%;

  height: 100%;

  transition: transform 0.8s;

  transform-style: preserve-3d;
}


/* ========================= */
/* EFEITO DE VIRAR */
/* ========================= */

.cartao:hover .cartao-interno {
  transform: rotateY(180deg);
}


/* ========================= */
/* FRENTE E VERSO */
/* ========================= */

.cartao-frente,
.cartao-verso {
  position: absolute;

  width: 100%;

  height: 100%;

  border-radius: 20px;

  overflow: hidden;

  backface-visibility: hidden;

  box-shadow:
    0 10px 25px rgba(0, 0, 0, 0.2);
}


/* ========================= */
/* FRENTE DO CARTÃO */
/* ========================= */

.cartao-frente {
  background: white;

  text-align: center;
}

.cartao-frente img {
  width: 100%;

  height: 270px;

  object-fit: cover;

  display: block;
}

.texto-frente {
  padding: 20px;
}

.texto-frente h3 {
  font-size: 20px;

  color: #222;

  margin-bottom: 10px;
}

.texto-frente p {
  color: #777;

  font-size: 14px;
}


/* ========================= */
/* VERSO DO CARTÃO */
/* ========================= */

.cartao-verso {
  background: #d32f2f;

  color: white;

  transform: rotateY(180deg);

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  text-align: center;

  padding: 35px;
}


/* VERSO VERDADEIRO */

.cartao-verso.verdadeiro {
  background: #2e7d32;
}


/* ÍCONE */

.icone {
  font-size: 55px;

  margin-bottom: 15px;
}


/* TÍTULO DO VERSO */

.cartao-verso h3 {
  font-size: 30px;

  margin-bottom: 20px;
}


/* TEXTO DO VERSO */

.cartao-verso p {
  font-size: 18px;

  line-height: 1.6;
}


/* ========================= */
/* RODAPÉ */
/* ========================= */

footer {
  background: #1b5e20;

  color: white;

  text-align: center;

  padding: 20px;
}


/* ========================= */
/* RESPONSIVO */
/* ========================= */

@media (max-width: 700px) {

  header {
    padding: 20px;
  }

  header h1 {
    font-size: 25px;
  }

  main {
    padding: 35px 15px;
  }

  main h2 {
    font-size: 23px;
  }

  .cartao {
    width: 290px;

    height: 400px;
  }

}