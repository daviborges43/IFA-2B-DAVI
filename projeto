* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #f5f5f5;
  text-align: center;
}

header {
  background-color: #222;
  color: white;
  padding: 20px;
}

nav a {
  color: white;
  text-decoration: none;
}

/* Área do cartão */
.cartao {
  width: 300px;
  height: 400px;
  margin: 40px auto;
  perspective: 1000px;
}

/* Parte que realmente gira */
.cartao-interno {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.8s;
  transform-style: preserve-3d;
}

/* Gira quando passa o mouse */
.cartao:hover .cartao-interno {
  transform: rotateY(180deg);
}

/* Frente e verso */
.cartao-frente,
.cartao-verso {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
}

/* Frente */
.cartao-frente {
  background-color: white;
}

/* Verso */
.cartao-verso {
  background-color: #4caf50;
  color: white;
  transform: rotateY(180deg);
}

/* Imagens */
.cartao-frente img,
.cartao-verso img {
  width: 100%;
  height: 260px;
  object-fit: cover;
}

/* Textos */
.cartao p {
  font-size: 20px;
  font-weight: bold;
  padding: 10px;
}

footer {
  margin-top: 50px;
  padding: 20px;
  background-color: #222;
  color: white;
}